# Doxygen configuration for CapsuleCreatures Studio (Doxygen 1.9.8 or later).
#
# Run `doxygen` in this folder; output goes to build-docs/html/index.html.
#
# Project rule (same as the engine): every module, class, function and
# attribute carries a Doxygen comment, and every documented function
# documents its parameters and return value. Python uses `"""!` docstrings
# and `##` comments. Warnings are errors, so anything undocumented fails.

PROJECT_NAME           = "CapsuleCreatures Studio"
PROJECT_BRIEF          = "Editors and tools for CapsuleCreatures projects"
OUTPUT_DIRECTORY       = build-docs
STRIP_FROM_PATH        = .
FULL_PATH_NAMES        = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

# Sources. Tests and the engine submodule are not part of the reference.
INPUT                  = editor toolkit README.md
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
EXCLUDE                = editor/tests .venv engine wheels
EXCLUDE_PATTERNS       = */__pycache__/* */build/*
USE_MDFILE_AS_MAINPAGE = ./README.md

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO
